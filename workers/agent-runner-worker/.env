# =============================================================================
# agent-runner-worker .env.example
# =============================================================================
# Copy to ``.env`` and adjust as needed. All values are PLACEHOLDERS /
# DEV-ONLY credentials for local development. Do NOT use in
# production. The workspace ``.gitignore`` excludes ``.env`` files.
#
# This file is the per-worker slice of the master env reference table
# (``platform/docs/env-reference.md``) and stays in parity with it
# (verified by ``tests/property/test_env_coverage.py``). Sensitive keys whose
# ``vault_path`` column is populated in env-reference.md are left
# **empty** or carry the ``_dev_only`` suffix.
# =============================================================================

# -----------------------------------------------------------------------------
# Observability (env-reference Â§12)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
CLIENT_SOURCE=agent-runner-worker

# -----------------------------------------------------------------------------
# Temporal (env-reference Â§3)
# -----------------------------------------------------------------------------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-runner

# -----------------------------------------------------------------------------
# MCP / Firecrawl (env-reference section 4; atlassian_mcp_bitbucket gateway)
# -----------------------------------------------------------------------------
MCP_BASE_URL=http://atlassian-mcp:8090
FIRECRAWL_BASE_URL=http://firecrawl:3002
FIRECRAWL_ENABLED=false

# -----------------------------------------------------------------------------
# LLM (env-reference section 5; agent-runner is one of the two LLM-capable
# components alongside assistant-service; full block is required so the
# provider can be switched at runtime)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# vault_path: vault:infrastructure/openai/api_key
OPENAI_API_KEY=
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# For local vLLM without auth, enter not-needed explicitly in the dashboard.
# vault_path: vault:infrastructure/vllm/api_key
VLLM_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# vault_path: vault:infrastructure/anthropic/api_key
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# MinIO (env-reference Â§6)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
# vault_path: vault:minio/access_keys
MINIO_ROOT_PASSWORD=miniosecret_dev_only

# -----------------------------------------------------------------------------
# OpenCode sidecar (env-reference Â§4 â€” Compose-internal endpoint)
# -----------------------------------------------------------------------------
OPENCODE_ENDPOINT=http://opencode-sidecar:4096
OPENCODE_MODEL=

# -----------------------------------------------------------------------------
# Feature flags (env-reference Â§11)
# -----------------------------------------------------------------------------
FEATURE_FLAG_AI_ENABLED=true
FEATURE_FLAG_FIRECRAWL_ENABLED=false
VAULT_ADDR=http://vault:8200
VAULT_BACKEND=hashicorp
VAULT_TOKEN=dev-token-not-for-prod
