# =============================================================================
# Workspace-root .env  (Compose Stack — Single Bootstrap Source)
# =============================================================================
# THIS is the single .env that Compose reads automatically (default ``.env``
# lookup) when you run the stack from the ``platform/`` directory:
#
#   docker compose -f infra/docker-compose.yml up -d
#
# That one command brings up the Boot_Bundle — the four services that MUST be
# running together so users can open the admin dashboard and manage everything
# else:
#
#   1. postgres             4. admin-dashboard-ui
#   2. vault                (admin-dashboard-api depends on postgres + vault)
#   3. admin-dashboard-api
#
# Every value those four services need is defined in THIS file (see the
# "BOOTSTRAP BUNDLE" sections below). Run the four together and they all read
# from here. Each individual service ALSO keeps its own ``services/<name>/.env``
# (and workers their ``workers/<name>/.env``) so anyone can run a single
# service standalone with its own values — but when the bundle comes up
# together, this root ``.env`` is the one source that wires postgres + vault +
# the dashboard.
#
# NOTE: ``.env`` is the ONLY env file used. There is no ``.env.example`` and
# none must ever be created (``.gitignore`` excludes ``.env`` / ``.env.*``).
#
# All values here are DEV-ONLY placeholders. Sensitive keys (carrying a
# ``vault_path`` comment) are resolved from Hashicorp Vault in production and
# MUST never be committed to git.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Postgres  [BOOTSTRAP BUNDLE 1/4]
# -----------------------------------------------------------------------------
# Read by the ``postgres`` container AND by ``admin-dashboard-api`` (via
# POSTGRES_DSN). When the bundle boots together the dashboard connects to the
# ``postgres`` service using these values. Anyone running postgres standalone
# picks the same values up from here.
POSTGRES_USER=ai
# vault_path: vault:infrastructure/postgres/password
POSTGRES_PASSWORD=ai_dev_only
POSTGRES_DB=ai
# vault_path: vault:infrastructure/postgres/dsn
POSTGRES_DSN=postgresql://ai:ai_dev_only@postgres:5432/ai
# Host port published for postgres (container always listens on 5432).
POSTGRES_HOST_PORT=35432


# -----------------------------------------------------------------------------
# 2. Vault  [BOOTSTRAP BUNDLE 2/4]
# -----------------------------------------------------------------------------
# Read by the ``vault`` container AND by ``admin-dashboard-api`` so the
# dashboard can resolve secrets from the Vault service that boots alongside it.
VAULT_ADDR=http://vault:8200
# vault_path: vault:infrastructure/vault/root_token
VAULT_TOKEN=dev-token-not-for-prod
VAULT_BACKEND=hashicorp


# -----------------------------------------------------------------------------
# 2b. admin-dashboard-api  [BOOTSTRAP BUNDLE 3/4]
# -----------------------------------------------------------------------------
# The control-plane API. Boots with postgres + vault (its ``depends_on``) and
# reads POSTGRES_DSN / VAULT_ADDR / VAULT_TOKEN above plus the keys here.
PLATFORM_ENV=development
AUTH_MODE=dev
AUTH_PROVIDER=local
WORKSPACE_ROOT=/app
# Temporal is NOT part of the Boot_Bundle; the API connects lazily at call
# time. Left pointing at the default address for when the temporal profile is
# activated later via the Setup Wizard.
TEMPORAL_HOST=temporal:7233
MCP_METRICS_URL=http://atlassian-mcp:8090


# -----------------------------------------------------------------------------
# 2c. admin-dashboard-ui  [BOOTSTRAP BUNDLE 4/4]
# -----------------------------------------------------------------------------
# The Next.js dashboard. Boots with (``depends_on``) admin-dashboard-api. The
# browser talks to the API through this public base URL.
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:38082
NEXT_PUBLIC_STREAMLIT_URL=http://localhost:38501
# CORS — comma-separated origins allowed to call admin-dashboard-api.
# Must include the admin-dashboard-ui host origin (ADMIN_DASHBOARD_UI_HOST_PORT).
CORS_ALLOW_ORIGINS=http://localhost:33000,http://127.0.0.1:33000


# -----------------------------------------------------------------------------
# 2d. Published host ports (single source of truth)
# -----------------------------------------------------------------------------
# Each service ALWAYS listens on its fixed container port internally; only the
# HOST-published port is configurable here so a deployment can avoid clashes
# with other software on the same machine. Change a value below and re-run
# ``docker compose up -d`` — never edit the Compose file or app source.
#   Admin Dashboard UI -> 33000   Admin Dashboard API -> 38082
#   Streamlit (chat)   -> 38501   Atlassian MCP       -> 38090
ADMIN_DASHBOARD_UI_HOST_PORT=33000
ADMIN_DASHBOARD_API_HOST_PORT=38082
STREAMLIT_HOST_PORT=38501
ATLASSIAN_MCP_HOST_PORT=38090
ASSISTANT_SERVICE_HOST_PORT=38081
AUTOMATION_SERVICE_HOST_PORT=38084
TASK_INTAKE_HOST_PORT=38083
VAULT_HOST_PORT=38200
REDIS_HOST_PORT=36379
TEMPORAL_HOST_PORT=37233
TEMPORAL_UI_HOST_PORT=38233
FIRECRAWL_HOST_PORT=33002
MINIO_HOST_PORT=39000
MINIO_CONSOLE_HOST_PORT=39001


# -----------------------------------------------------------------------------
# 3. Temporal (env-reference §3)
# -----------------------------------------------------------------------------
TEMPORAL_HOST=temporal:7233
# Worker-scoped task queue name; per-worker ``.env.example`` overrides this
# with the worker-specific value (``agent-runner`` / ``execution-runner``).
TEMPORAL_TASK_QUEUE=agent-runner


# -----------------------------------------------------------------------------
# 4. MCP / Firecrawl (env-reference §4)
# -----------------------------------------------------------------------------
MCP_BASE_URL=http://atlassian-mcp:8090
FIRECRAWL_BASE_URL=http://firecrawl:3002


# -----------------------------------------------------------------------------
# 5. LLM (env-reference §5)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# vault_path: vault:infrastructure/openai/api_key
OPENAI_API_KEY="openai_key"
# vault_path: vault:infrastructure/anthropic/api_key
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# 6. MinIO (env-reference §6)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
# vault_path: vault:minio/access_keys
MINIO_ROOT_PASSWORD=miniosecret_dev_only


# -----------------------------------------------------------------------------
# 10. SSH runners (env-reference §10 — execution-runner-worker workspace root)
# -----------------------------------------------------------------------------
# Workspace kök klasörü. Task workspace'leri
# {RUNNER_BASE_PATH}/{ISSUE_KEY}/iter-{N}/ formatında oluşturulur
# (``platform-mimari-uyumluluk`` Requirement 11.1 / Q13). Yalnızca
# ``execution-runner-worker`` tüketir; uygulama katmanında
# ``runners/workspace_path.build_workspace_path`` helper'ı bu değeri
# ve ``SSH_BASE_PATH`` (deprecated alias) fallback'ini ``AliasChoices`` ile
# birlikte okur.
#
# DEPRECATED — SSH_HOST is deprecated. Use the infrastructure.ssh_runners
# table (managed via admin panel at /admin/security/ssh-runners) instead.
# When SSH_HOST is set at boot, the execution-runner-worker auto-seeds a
# 'default' runner row for backward compatibility (R4.3, R4.17).
# New deployments MUST NOT rely on SSH_HOST; configure runners via the
# admin panel instead.
SSH_HOST=
RUNNER_BASE_PATH=/var/ai-runner
# SSH_BASE_PATH (deprecated alias for RUNNER_BASE_PATH) — geriye uyum için
# ``pydantic-settings`` aracılığıyla fallback olarak okunur; yeni
# deployment'larda set edilmemelidir.
# SSH_BASE_PATH=/var/ai-runner

# Workspace disk auto-prune eşikleri (G2: WorkspaceCleanupSchedulerWorkflow).
# WARN_PCT'ye ulaşıldığında admin-dashboard'a sarı banner gönderilir;
# EVICT_PCT'ye ulaşıldığında en eski iter-N klasörleri silinir.
RUNNER_DISK_WARN_PCT=80
RUNNER_DISK_EVICT_PCT=90


# -----------------------------------------------------------------------------
# 11. Feature flags (env-reference §11 — every flag default-off / opt-in)
# -----------------------------------------------------------------------------
FEATURE_FLAG_AI_ENABLED=true
FEATURE_FLAG_EXECUTION_ENABLED=true
FEATURE_FLAG_TASK_INTAKE_ENABLED=false
FEATURE_FLAG_FIRECRAWL_ENABLED=false
FEATURE_FLAG_PR_AUTO_MERGE_ENABLED=false
FEATURE_FLAG_AUDIT_PRUNE_ENABLED=false
# V1 / V9 SSH dept gating (Requirements 4.8, 4.9 — default-off)
# DEPRECATED — single-runner kanonik kontrat (G1) altında bu iki flag
# no-op'tur. Per-dept SSH pinning ve per-dept quota kaldırıldı; tek SSH
# host'u tüm departmanlarca paylaşılır ve disk yönetimi global
# RUNNER_DISK_WARN_PCT / RUNNER_DISK_EVICT_PCT eşikleri ile yapılır.
SSH_RUNNER_DEPT_PINNING_ENABLED=false
SSH_DEPT_QUOTA_ENABLED=false


# -----------------------------------------------------------------------------
# 12. Observability / Log (env-reference §12)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
