# =============================================================================
# opencode-sidecar .env.example
# =============================================================================
# Compose-internal LLM code-generation sidecar (Requirement 1.10, 2.9).
# Reachable only on the Compose internal network via ``expose: 4096`` —
# this service MUST NOT publish any host port (test_compose_structure
# enforces ``ports:`` absence for ``kind=sidecar``).
#
# This file is the per-service slice of the master env reference table
# (``platform/docs/env-reference.md``, task 10.4) and stays in parity
# with it (Requirement 8.4 — verified by
# ``tests/property/test_env_coverage.py``).
#
# All values are PLACEHOLDERS / DEV-ONLY. Never commit a populated
# ``.env`` to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Service runtime
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM upstream (env-reference §5 — Compose stack does NOT package vLLM,
# Requirement 2.6; the endpoint is resolved from VLLM_BASE_URL)
# -----------------------------------------------------------------------------
LLM_MODEL_NAME=qwen2.5-coder
VLLM_BASE_URL=http://host.docker.internal:8000/v1
