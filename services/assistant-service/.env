# =============================================================================
# assistant-service .env.example (Standalone Mode)
# =============================================================================
# Copy this file to ``.env`` and run:
# docker run --env-file .env -p 8081:8081 assistant-service
#
# All values below are PLACEHOLDERS / DEV-ONLY credentials
# for local development. Do NOT use these values in production.
#
# This file is the per-service slice of the master env reference table
# (``platform/docs/env-reference.md``) and stays in parity with it
# (verified by ``tests/property/test_env_coverage.py``).
# Sensitive keys whose ``vault_path`` column is populated in env-reference.md
# are left **empty**.
# =============================================================================

# -----------------------------------------------------------------------------
# Service runtime
# -----------------------------------------------------------------------------
PORT=8081
LOG_LEVEL=INFO
CLIENT_SOURCE=assistant-service

# -----------------------------------------------------------------------------
# Postgres (env-reference §1)
# -----------------------------------------------------------------------------
# vault_path: vault:infrastructure/postgres/dsn
POSTGRES_DSN=postgresql://ai:ai_dev_only@postgres:5432/ai

# -----------------------------------------------------------------------------
# Redis (chat session / rate limit cache — service-specific, not in
# env-reference because Redis is not part of the foundation invariant set)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# MCP / Firecrawl (env-reference §4 — atlassian_mcp_bitbucket gateway)
# -----------------------------------------------------------------------------
MCP_BASE_URL=http://atlassian-mcp:8090

# -----------------------------------------------------------------------------
# OpenCode sidecar (env-reference §4)
# -----------------------------------------------------------------------------
OPENCODE_ENDPOINT=http://opencode-sidecar:4096

# -----------------------------------------------------------------------------
# OIDC / Auth (env-reference §7, §8)
# -----------------------------------------------------------------------------
AUTH_PROVIDER=oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# vault_path: vault:infrastructure/oidc/client_secret
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# -----------------------------------------------------------------------------
# LLM (env-reference §5 — full provider block, switch via LLM_PROVIDER)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-5.5
LLM_REASONING_EFFORT=medium
LLM_VERBOSITY=
OPENAI_BASE_URL=https://api.openai.com/v1
# vault_path: vault:infrastructure/openai/api_key
OPENAI_API_KEY=
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# For local vLLM without auth, enter not-needed explicitly in the dashboard.
# vault_path: vault:infrastructure/vllm/api_key
VLLM_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# vault_path: vault:infrastructure/anthropic/api_key
ANTHROPIC_API_KEY=
