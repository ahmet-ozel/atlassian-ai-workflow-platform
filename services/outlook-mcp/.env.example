# =============================================================================
# outlook-mcp .env.example
# =============================================================================
# Copy this file to `.env` for local development.
# Do not commit the real `.env` file or real OAuth secrets.
# =============================================================================

PORT=8120
MAIL_MCP_PROVIDER=outlook
MAIL_MCP_READ_ONLY=true

# Multi-user default:
# User refresh/access tokens are NOT stored in .env. They are written per
# Streamlit session into Vault by assistant-service and passed to this service
# as a credential ref.
MAIL_MCP_OAUTH_MODEL=per_user_vault
MAIL_MCP_ALLOW_ENV_USER_TOKEN=false

# Credential backend. Production should use Hashicorp Vault. Local development
# can opt into the encrypted file backend shared with assistant-service so
# mail OAuth credentials survive Docker restarts:
# VAULT_BACKEND=local-dev
# VAULT_LOCAL_KEY=<32 random bytes, hex or base64 encoded>
# VAULT_LOCAL_STORE=/vault-local/vault.json

# Advanced overrides, mostly for tests/proxies.
MICROSOFT_TOKEN_URI=
MICROSOFT_GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0

# Optional local-only single-account fallback. Keep disabled for shared/company
# deployments; enabling it makes every user read the same mailbox.
# MAIL_MCP_ALLOW_ENV_USER_TOKEN=true
# MICROSOFT_TENANT_ID=common
# MICROSOFT_CLIENT_ID=local-dev-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=local-dev-microsoft-client-secret
# MICROSOFT_SCOPES=offline_access Mail.Read
# MICROSOFT_REFRESH_TOKEN=local-dev-user-refresh-token
# MICROSOFT_ACCESS_TOKEN=
