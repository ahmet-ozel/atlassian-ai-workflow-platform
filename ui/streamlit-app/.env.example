# =============================================================================
# streamlit-app .env.example (Standalone Mode)
# =============================================================================
# Copy this file to `.env` and run:
# docker run --env-file .env -p 8501:8501 streamlit-app
#
# All values below are PLACEHOLDERS / DEV-ONLY credentials
# for local development. Do NOT use these values in production.
# =============================================================================

# --- Service ---
PORT=8501
LOG_LEVEL=INFO

# --- assistant-service (chat / task creator backend) ---
ASSISTANT_BASE_URL=http://assistant-service:8081

# --- MCP (atlassian_mcp_bitbucket) ---
MCP_BASE_URL=http://atlassian-mcp:8090

# --- Mail MCP ---
GMAIL_MCP_BASE_URL=http://gmail-mcp:8110
OUTLOOK_MCP_BASE_URL=http://outlook-mcp:8120

# --- AI model provider (Dashboard Start modal) ---
# LLM_PROVIDER can be openai, vllm, or anthropic.
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-5.5
LLM_REASONING_EFFORT=medium
LLM_VERBOSITY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- X-Client-Source (optional override) ---
CLIENT_SOURCE=streamlit-app
