# =============================================================================
# automation-worker .env.example
# =============================================================================
# Copy to ``.env`` and adjust as needed. All values are PLACEHOLDERS /
# DEV-ONLY credentials. Do NOT use
# in production. The workspace ``.gitignore`` excludes ``.env`` files.
#
# This file is the per-worker slice of the master env reference table
# (``platform/docs/env-reference.md``) and stays in parity with it.
# Sensitive keys whose ``vault_path`` column is populated in
# env-reference.md are left **empty** or carry the ``_dev_only`` suffix
# for local development safety.
#
# The ``automation-worker`` hosts the ``automation-tq`` Temporal task
# queue. It registers:
#   * ``AutomationWorkflow``       — gateway + capability gate
#   * ``BotBranchRetention``       — daily cron for orphan ai/* branches
#   * ``AuditPruneWorkflow``       — daily cron archives audit_events
# =============================================================================

# -----------------------------------------------------------------------------
# Observability (env-reference §12)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
CLIENT_SOURCE=automation-worker

# -----------------------------------------------------------------------------
# Temporal (env-reference §3 — single task queue per worker)
# -----------------------------------------------------------------------------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=automation-tq

# -----------------------------------------------------------------------------
# Postgres (env-reference §1 — audit_events read/delete + retention lookup)
# -----------------------------------------------------------------------------
# vault_path: vault:infrastructure/postgres/dsn
POSTGRES_DSN=postgresql://ai:ai_dev_only@postgres:5432/ai

# -----------------------------------------------------------------------------
# Vault (env-reference §2 — Slack webhook + secret resolution)
# -----------------------------------------------------------------------------
VAULT_BACKEND=hashicorp
VAULT_ADDR=http://vault:8200
# vault_path: vault:infrastructure/vault/root_token
VAULT_TOKEN=dev-token-not-for-prod

# -----------------------------------------------------------------------------
# MinIO (env-reference §6 — audit-archive bucket sink for daily prune)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
# vault_path: vault:minio/access_keys
MINIO_ROOT_PASSWORD=miniosecret_dev_only
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# vault_path: vault:infrastructure/openai/api_key
OPENAI_API_KEY=
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# For local vLLM without auth, enter not-needed explicitly in the dashboard.
# vault_path: vault:infrastructure/vllm/api_key
VLLM_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# vault_path: vault:infrastructure/anthropic/api_key
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Audit prune retention — RETENTION_DAYS overrides default 90.
# -----------------------------------------------------------------------------
RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Notification — Slack admin webhook for audit_prune_failed alarm.
# vault_path: vault:notifications/slack/admin
# -----------------------------------------------------------------------------
SLACK_ADMIN_WEBHOOK=
