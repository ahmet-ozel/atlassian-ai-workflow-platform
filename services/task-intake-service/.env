# =============================================================================
# task-intake-service .env.example (Standalone Mode)
# =============================================================================
# Copy this file to `.env` and run:
#   docker run --env-file .env -p 8083:8083 task-intake-service
#
# Note: this service is gated behind the Compose profile `task-intake`
# (Requirement 16.1 / Compose §10.1). It is NOT started by default.
#
# All values below are PLACEHOLDERS / DEV-ONLY credentials
# (Requirements 10.6, 11.5). Do NOT use these values in production.
# =============================================================================

# --- Service ---
PORT=8083
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_DSN=postgresql://ai:ai_dev_only@postgres:5432/ai

# --- Temporal ---
TEMPORAL_HOST=temporal:7233

# --- MCP (atlassian_unified) ---
MCP_BASE_URL=http://atlassian-mcp:8090

# --- Firecrawl (web ingestion) ---
FIRECRAWL_BASE_URL=http://firecrawl:3002

# --- X-Client-Source (Requirement 13.4 — optional override) ---
CLIENT_SOURCE=task-intake-service
