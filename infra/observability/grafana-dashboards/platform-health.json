{
  "title": "Platform Health",
  "uid": "platform-health",
  "tags": ["platform-mimari-ops", "health", "ops"],
  "timezone": "utc",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service health (1=ok, 0.5=degraded, 0=down)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "healthcheck_status",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.5, "color": "yellow" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Audit prune failures (24h) — admin alarm gate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(increase(audit_prune_failed_total[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Audit rows archived per day",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 6 },
      "targets": [
        {
          "expr": "increase(audit_prune_archived_rows_total[1d])",
          "legendFormat": "archived"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Notification dispatch outcomes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (channel, result) (rate(notification_dispatch_total[5m]))",
          "legendFormat": "{{channel}} · {{result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Chat PII matches by kind",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (pii_kind) (rate(chat_pii_matches_total[5m]))",
          "legendFormat": "{{pii_kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Chat throughput by result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum by (result) (rate(chat_messages_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
