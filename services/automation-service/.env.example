# =============================================================================
# automation-service .env.example (Standalone Mode)
# =============================================================================
# Copy this file to ``.env`` and run:
#   docker run --env-file .env -p 8080:8080 automation-service
#
# All values below are PLACEHOLDERS / DEV-ONLY credentials. Production
# credentials live in Hashicorp Vault and are referenced by ``vault:`` paths
# (Requirement 6.1). Never commit a populated ``.env`` to git.
#
# This file is the per-service slice of the master env reference table
# (``platform/docs/env-reference.md``, task 10.4) and stays in parity with
# it (Requirements 8.3, 8.4 — verified by ``tests/property/test_env_coverage.py``).
# Sensitive keys whose ``vault_path`` column is populated in env-reference.md
# are left **empty** or carry the ``_dev_only`` suffix (Requirement 8.5, 8.8).
# =============================================================================

# -----------------------------------------------------------------------------
# Service runtime
# -----------------------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO
CLIENT_SOURCE=automation-service

# -----------------------------------------------------------------------------
# Postgres (env-reference §1; Requirement 7.4 RLS, design §"Postgres şeması")
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai
POSTGRES_USER=ai
# vault_path: vault:infrastructure/postgres/password
POSTGRES_PASSWORD=ai_dev_only
# vault_path: vault:infrastructure/postgres/dsn
POSTGRES_DSN=postgresql://ai:ai_dev_only@postgres:5432/ai

# -----------------------------------------------------------------------------
# Vault (env-reference §2; Requirements 6.1, 6.6 — pluggable backend)
# -----------------------------------------------------------------------------
# VAULT_BACKEND ∈ {hashicorp, local-dev}; ``local-dev`` rejects plain-text.
VAULT_BACKEND=hashicorp
VAULT_ADDR=http://vault:8200
# vault_path: vault:infrastructure/vault/root_token
VAULT_TOKEN=dev-token-not-for-prod
VAULT_NAMESPACE=
# Mount points used by automation-service for credential staging /
# atomic department create rollback (Requirement 3.6).
VAULT_KV_MOUNT=secret

# -----------------------------------------------------------------------------
# Temporal (env-reference §3; Requirement 1.6 idempotency)
# -----------------------------------------------------------------------------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
# Default workflow start queue used by the orchestrator. Workers carry their
# own ``TEMPORAL_TASK_QUEUE`` value (``agent-runner`` / ``execution-runner``)
# in ``workers/<name>/.env.example``.
TEMPORAL_TASK_QUEUE=agent-runner

# -----------------------------------------------------------------------------
# MCP / Firecrawl (env-reference §4; Requirement 1.2 single-source enforcement)
# -----------------------------------------------------------------------------
MCP_BASE_URL=http://atlassian-mcp:8090
FIRECRAWL_BASE_URL=http://firecrawl:3002
FIRECRAWL_ENABLED=false

# -----------------------------------------------------------------------------
# Webhook secrets (env-reference §9; Requirements 6.4, 6.8 — per-dept HMAC
# + 1h rotation overlap)
# -----------------------------------------------------------------------------
# Per-department secrets are resolved from
# ``vault:webhooks/<provider>/<dept_id>`` (the prefix below). Only the prefix
# and the per-provider header names live in env; the rotation overlap window
# is the same for every provider (1h default).
WEBHOOK_HMAC_HEADER_JIRA=X-Hub-Signature-256
WEBHOOK_HMAC_HEADER_BITBUCKET=X-Hub-Signature
WEBHOOK_HMAC_HEADER_CONFLUENCE=X-Atlassian-Webhook-Identifier
WEBHOOK_SECRET_VAULT_PREFIX=vault:webhooks
WEBHOOK_ROTATION_OVERLAP_S=3600
WEBHOOK_REPLAY_WINDOW_S=300
WEBHOOK_BODY_MAX_BYTES=1048576

# -----------------------------------------------------------------------------
# OIDC / Auth (env-reference §7, §8; Requirements 7.1, 7.2)
# -----------------------------------------------------------------------------
# AUTH_PROVIDER ∈ {oidc, local}; ``local`` is for development only.
AUTH_PROVIDER=oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# vault_path: vault:infrastructure/oidc/client_secret
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# -----------------------------------------------------------------------------
# LLM provider block (env-reference §5; Requirement 6.9 — Vault-backed fallback)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# vault_path: vault:infrastructure/openai/api_key
OPENAI_API_KEY=
# vault_path: vault:infrastructure/anthropic/api_key
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Feature flags (env-reference §11; Requirements 4.8, 4.9 — default-off)
# -----------------------------------------------------------------------------
FEATURE_FLAG_AI_ENABLED=true
FEATURE_FLAG_EXECUTION_ENABLED=true
FEATURE_FLAG_FIRECRAWL_ENABLED=false
FEATURE_FLAG_PR_AUTO_MERGE_ENABLED=false
# DEPRECATED — these flags are no-ops under the single-runner canonical
# contract (G1: per-dept SSH pinning is removed). Defaults remain ``false``
# and they continue to be read for env-coverage parity, but the runtime
# does NOT consult them. They will be removed in a future release.
SSH_RUNNER_DEPT_PINNING_ENABLED=false
SSH_DEPT_QUOTA_ENABLED=false

# -----------------------------------------------------------------------------
# Inbound channel adapters (task 8.5, B19 — Requirement 5.10)
# -----------------------------------------------------------------------------
# Slack → task adapter. The signing secret per dept lives in Vault at
# ``vault:notifications/slack_inbound/<dept_id>``; the SlackSignatureVerifier
# resolver constructed in startup hooks reads from that path.
SLACK_INBOUND_SIGNING_SECRET_VAULT_PREFIX=vault:notifications/slack_inbound

# Email → task adapter (IMAP poller). Disabled while EMAIL_INBOUND_ADDRESS
# is empty; populating it requires the IMAP block below.
EMAIL_INBOUND_ADDRESS=
EMAIL_INBOUND_IMAP_HOST=
EMAIL_INBOUND_IMAP_PORT=993
EMAIL_INBOUND_IMAP_USER=
# vault_path: vault:notifications/imap/credential
EMAIL_INBOUND_IMAP_PASSWORD_REF=
EMAIL_INBOUND_IMAP_FOLDER=INBOX
EMAIL_INBOUND_IMAP_USE_SSL=true
EMAIL_INBOUND_POLL_INTERVAL_S=60
