# =============================================================================
# firecrawl .env.example
# =============================================================================
# Egress-allowlisted web scrape/search wrapper. Copy to ``.env`` and run:
#   docker compose -f infra/docker-compose.yml --profile firecrawl up firecrawl
#
# All values below are PLACEHOLDERS / DEV-ONLY. Never commit a populated
# ``.env`` to git. This file is the per-service slice of the master env
# reference table (``platform/docs/env-reference.md``, Requirement 8.4)
# and is verified against it by ``tests/property/test_env_coverage.py``.
# =============================================================================

# -----------------------------------------------------------------------------
# Service runtime
# -----------------------------------------------------------------------------
PORT=3002
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Egress allowlist enforcement (Requirement 10.3, MIMARI §16.14 Y3)
# -----------------------------------------------------------------------------
# Comma-separated list of host suffixes the wrapper will allow Firecrawl to
# fetch. The match is performed on a label boundary, so ``example.com``
# permits ``example.com`` and ``foo.example.com`` but NOT ``barexample.com``.
#
# An empty value denies every external host (closed by default). Production
# deployments populate this from a curated list of documentation, vendor
# docs, and search engine domains.
FIRECRAWL_EGRESS_ALLOWLIST=

# -----------------------------------------------------------------------------
# Upstream Firecrawl forwarding (optional)
# -----------------------------------------------------------------------------
# When set, allow-listed requests are forwarded to a co-located upstream
# Firecrawl instance instead of being fetched directly via ``httpx``. Leave
# empty in dev for the lightweight built-in fetcher path.
FIRECRAWL_UPSTREAM_BASE_URL=

# vault_path: vault:infrastructure/firecrawl/api_key
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# HTTP client tuning
# -----------------------------------------------------------------------------
FIRECRAWL_REQUEST_TIMEOUT_S=30
