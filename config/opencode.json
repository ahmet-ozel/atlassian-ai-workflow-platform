{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-4o-mini": {
          "name": "GPT-4o mini"
        }
      }
    },
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM",
      "options": {
        "baseURL": "{env:VLLM_BASE_URL}",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "qwen2.5-coder": {
          "name": "Qwen 2.5 Coder"
        }
      }
    }
  }
}
