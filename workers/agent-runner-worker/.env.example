# =============================================================================
# agent-runner-worker .env.example
# =============================================================================
# Copy to ``.env`` and adjust as needed. All values are PLACEHOLDERS /
# DEV-ONLY credentials (Requirements 8.8, 11.5). Do NOT use in
# production. The workspace ``.gitignore`` excludes ``.env`` files.
#
# This file is the per-worker slice of the master env reference table
# (``platform/docs/env-reference.md``, task 10.4) and stays in parity
# with it (Requirement 8.4 — verified by
# ``tests/property/test_env_coverage.py``). Sensitive keys whose
# ``vault_path`` column is populated in env-reference.md are left
# **empty** or carry the ``_dev_only`` suffix (Requirement 8.5, 8.8).
# =============================================================================

# -----------------------------------------------------------------------------
# Observability (env-reference §12)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
CLIENT_SOURCE=agent-runner-worker

# -----------------------------------------------------------------------------
# Temporal (env-reference §3)
# -----------------------------------------------------------------------------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-runner

# -----------------------------------------------------------------------------
# MCP / Firecrawl (env-reference §4 — atlassian_unified single-source)
# -----------------------------------------------------------------------------
MCP_BASE_URL=http://atlassian-mcp:8090
FIRECRAWL_BASE_URL=http://firecrawl:3002
FIRECRAWL_ENABLED=false

# -----------------------------------------------------------------------------
# Vault (Atlassian bot credential resolution)
# -----------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_BACKEND=kv
# vault_path: vault:infrastructure/vault/root_token
VAULT_TOKEN=

# -----------------------------------------------------------------------------
# LLM (env-reference §5 — agent-runner is one of the two LLM-capable
# components alongside assistant-service; full block is required so the
# provider can be switched at runtime — Requirement 10.4)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# vault_path: vault:infrastructure/openai/api_key
OPENAI_API_KEY=
# vault_path: vault:infrastructure/anthropic/api_key
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# MinIO (env-reference §6)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
# vault_path: vault:minio/access_keys
MINIO_ROOT_PASSWORD=miniosecret_dev_only

# -----------------------------------------------------------------------------
# OpenCode sidecar (env-reference §4 — Compose-internal endpoint)
# -----------------------------------------------------------------------------
OPENCODE_ENDPOINT=http://opencode-sidecar:4096
OPENCODE_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Feature flags (env-reference §11)
# -----------------------------------------------------------------------------
FEATURE_FLAG_AI_ENABLED=true
FEATURE_FLAG_FIRECRAWL_ENABLED=false
