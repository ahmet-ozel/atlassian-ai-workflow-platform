{#
  default.html.j2 — Default PDF template for ``jira_attachment`` output
  actions (workflow type ``research_summary_jira`` and friends).

  Default workflow report template.

  Contract:
    * Page size pinned to A4 with 18 mm margins via ``@page`` so the
      Jira attachment renders identically on every host.
    * Body uses a Latin-1 / Latin Extended-A capable, system-available
      sans-serif stack (DejaVu Sans → Liberation Sans → sans-serif).
      Turkish glyphs (ç, ğ, ı, ö, ş, ü, Ç, Ğ, İ, Ö, Ş, Ü) are part of
      Latin Extended-A and therefore covered by every fallback in the
      stack.
    * UTF-8 throughout; no inline JavaScript, no remote fetches, no
      `<style>` directives that would force a network round-trip.
      WeasyPrint resolves CSS deterministically from this single
      ``<style>`` block, so a given (template, context) pair always
      produces the same byte sequence (modulo metadata pinned by
      :func:`temporal_shared.pdf_render.render_pdf`).

  Required context keys:
    * ``title`` — string, used for ``<title>`` and ``<h1>``.
    * ``body_html`` — pre-rendered HTML fragment. The caller is
      responsible for sanitising it.

  Optional context keys:
    * ``subtitle`` — short subtitle below the heading.
    * ``footer`` — short footer string (e.g. provenance).
    * ``lang`` — ISO-639-1 code; defaults to ``tr``.

  All variables are emitted with the default Jinja2 autoescape (set at
  Environment level by :mod:`temporal_shared.pdf_render`).
#}
<!DOCTYPE html>
<html lang="{{ lang | default('tr') }}">
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <style>
    @page {
      size: A4;
      margin: 18mm;
    }

    /* Latin / Latin Extended-A coverage (Turkish glyphs included).
       The fallback chain prefers DejaVu Sans because it ships with the
       weasyprint Linux runtime image; Liberation Sans is the typical
       Red Hat / Fedora fallback; ``sans-serif`` is the WeasyPrint
       built-in last resort. */
    html, body {
      font-family: "DejaVu Sans", "Liberation Sans", "Noto Sans", sans-serif;
      font-size: 11pt;
      line-height: 1.45;
      color: #1a1a1a;
      margin: 0;
      padding: 0;
    }

    h1, h2, h3, h4 {
      font-family: "DejaVu Sans", "Liberation Sans", "Noto Sans", sans-serif;
      color: #0b3d91;
      margin-top: 1.2em;
      margin-bottom: 0.4em;
    }

    h1 { font-size: 20pt; }
    h2 { font-size: 16pt; }
    h3 { font-size: 13pt; }
    h4 { font-size: 11.5pt; }

    p { margin: 0 0 0.6em 0; }

    ul, ol { margin: 0 0 0.6em 1.4em; padding: 0; }
    li { margin-bottom: 0.2em; }

    code, pre {
      font-family: "DejaVu Sans Mono", "Liberation Mono", monospace;
      font-size: 10pt;
    }
    pre {
      background: #f4f4f4;
      padding: 8pt;
      border: 0.5pt solid #d0d0d0;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      margin: 0.6em 0;
    }
    th, td {
      border: 0.5pt solid #b0b0b0;
      padding: 4pt 6pt;
      text-align: left;
      vertical-align: top;
    }
    th { background: #eef2fb; }

    .subtitle {
      color: #555;
      font-size: 11pt;
      margin: 0 0 1.2em 0;
    }

    .footer {
      margin-top: 2em;
      padding-top: 0.5em;
      border-top: 0.5pt solid #c0c0c0;
      color: #666;
      font-size: 9pt;
    }
  </style>
</head>
<body>
  <h1>{{ title }}</h1>
  {%- if subtitle %}
  <p class="subtitle">{{ subtitle }}</p>
  {%- endif %}
  <div class="body">
    {{ body_html | safe }}
  </div>
  {%- if footer %}
  <div class="footer">{{ footer }}</div>
  {%- endif %}
</body>
</html>
