# =============================================================================
# admin-dashboard-api .env.example (Standalone Mode)
# =============================================================================
# Copy this file to `.env` and run:
#   docker run --env-file .env -p 8082:8082 admin-dashboard-api
#
# All values below are PLACEHOLDERS / DEV-ONLY credentials
# (Requirements 10.6, 11.5). Do NOT use these values in production.
# =============================================================================

# --- Service ---
PORT=8082
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_DSN=postgresql://ai:ai_dev_only@postgres:5432/ai

# --- Vault ---
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-token-not-for-prod

# --- Temporal ---
TEMPORAL_HOST=temporal:7233

# --- LLM (Requirement 10.4 — admin-api proxies LLM cost views) ---
LLM_PROVIDER=openai
VLLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- X-Client-Source (Requirement 13.4 — optional override) ---
CLIENT_SOURCE=admin-dashboard-api

# --- MCP traffic stats (platform-gap-fill task 8.3 — Requirement 9.5) ---
# Base URL of the Atlassian MCP server (without trailing /metrics). The
# admin-dashboard-api scrapes ``${MCP_METRICS_URL}/metrics`` and parses
# the ``mcp_requests_total{client_source, tool, status}`` counter to
# surface the traffic view at ``GET /api/v1/mcp/traffic``.
MCP_METRICS_URL=http://atlassian-mcp:8090
# =============================================================================
# Control_Plane Configuration (admin-dashboard-control-plane spec — design §3.14)
# =============================================================================
# The keys below were appended by the admin-dashboard-control-plane spec to
# wire OIDC validation, manifest discovery, Compose orchestration and the
# polling-based health probe. Existing LHS keys above (PORT, LOG_LEVEL,
# POSTGRES_DSN, VAULT_*, TEMPORAL_*, LLM_*, CLIENT_SOURCE) MUST NOT be
# removed or modified (Requirement 13.3).
# =============================================================================

# --- OIDC / AuthN (Requirement 10.4, 10.6 — design §3.14) ---
# AUTH_MODE: "dev" accepts unsigned tokens with a synthetic admin claim
# (development only); "production" enforces JWKS signature, iss, aud and exp
# checks via libs/auth-shared/oidc.py. No bypass exists in production mode.
AUTH_MODE=dev
# OIDC_ISSUER: expected `iss` claim value (e.g. https://idp.example.com/).
# Required when AUTH_MODE=production; ignored when AUTH_MODE=dev.
OIDC_ISSUER=
# OIDC_AUDIENCE: expected `aud` claim value for admin-dashboard-api.
OIDC_AUDIENCE=
# OIDC_JWKS_URL: JWKS endpoint used to fetch RS256 signing keys (cached >=5 min).
OIDC_JWKS_URL=

# =============================================================================
# platform-mimari-foundation Configuration (task 8.3 — Requirements 1.10, 8.4)
# =============================================================================
# The keys below were appended by the platform-mimari-foundation spec to
# wire the auth-shared OIDC layer (libs/auth-shared/src/auth_shared/oidc.py)
# and the AdminProxy forwarder (task 8.2). They MUST stay in sync with
# platform/docs/env-reference.md (Requirement 8.4 — env-reference parity).
# Existing LHS keys above (PORT, LOG_LEVEL, POSTGRES_DSN, VAULT_*, TEMPORAL_*,
# LLM_*, CLIENT_SOURCE, AUTH_MODE, OIDC_ISSUER, OIDC_AUDIENCE, OIDC_JWKS_URL,
# HEALTH_*, MANIFEST_*, COMPOSE_FILE, SERVICES_MANIFEST_PATH) MUST NOT be
# removed or modified.
# =============================================================================

# --- Auth provider selector (Requirement 7.2 — env-reference §8) ---
# AUTH_PROVIDER selects which authentication mechanism the auth-shared
# layer activates: "oidc" (production — full JWKS verification via the
# OIDC_* keys below) or "local" (dev only — username/password against
# AUTH_LOCAL_USERNAME/AUTH_LOCAL_PASSWORD; never accepted in production).
AUTH_PROVIDER=oidc

# --- OIDC client wiring (Requirement 7.2 — env-reference §7) ---
# OIDC_ISSUER_URL: the issuer root URL used for `.well-known/openid-configuration`
# discovery (e.g. https://idp.example.com/). Required when AUTH_PROVIDER=oidc.
OIDC_ISSUER_URL=
# OIDC_CLIENT_ID: OIDC client identifier obtained from the IdP console.
# Required when AUTH_PROVIDER=oidc.
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET: OIDC client secret. In production this value MUST
# be resolved from `vault:infrastructure/oidc/client_secret` (env-reference §7);
# the placeholder below is empty so accidental boots fail closed.
OIDC_CLIENT_SECRET=
# OIDC_SCOPES: space-separated scope list requested during the
# Authorization Code flow. Default at runtime is "openid profile email"
# (env-reference §7); leave blank in the example to satisfy the
# placeholder-only invariant (Requirement 8.8 / 11.5) — the application
# layer applies the documented default when the variable is unset.
OIDC_SCOPES=
# OIDC_REDIRECT_URI: callback URL registered with the IdP; must match
# the provider entry exactly. Leave blank in standalone-mode local dev.
OIDC_REDIRECT_URI=

# --- AdminProxy forwarder (Requirement 1.10, 10.6 — design §3.14) ---
# AUTOMATION_SERVICE_URL: base URL of the automation-service that owns
# every `/admin/*` endpoint. The AdminProxy (task 8.2) forwards each
# verified request to `<AUTOMATION_SERVICE_URL>/admin/...`; this service
# implements no admin endpoints on its own (Requirement 3.5).
AUTOMATION_SERVICE_URL=http://automation-service:8080

# --- Health Probe / Lifecycle (Requirement 7, 12 — design §3.14, §3.6) ---
# HEALTH_POLL_INTERVAL_SECONDS: cadence of background /healthz polling.
# Allowed range [5, 30]; default 10.
HEALTH_POLL_INTERVAL_SECONDS=10
# HEALTH_READY_TIMEOUT_SECONDS: max wait after `compose up` for /healthz=200
# before marking the service `failed`. Allowed range [5, 180]; default 60.
HEALTH_READY_TIMEOUT_SECONDS=60
# HEALTH_FAIL_STREAK_THRESHOLD: consecutive unhealthy polls that trigger a
# single `health_streak_alert` audit entry (Requirement 12.5).
# Allowed range [1, 10]; default 3.
HEALTH_FAIL_STREAK_THRESHOLD=3

# --- Manifest / Compose (Requirement 3 — design §3.14, §3.2) ---
# MANIFEST_REFRESH_SECONDS: in-memory manifest cache TTL.
# Allowed range [10, 600]; default 60.
MANIFEST_REFRESH_SECONDS=60
# SERVICES_MANIFEST_PATH: workspace-root-relative path to the Service_Manifest.
# Default at runtime: ``config/services.manifest.json``. Left blank in the
# example to satisfy the placeholder-only invariant
# (Requirement 8.8 / 11.5); the application applies the documented default
# when the variable is unset.
SERVICES_MANIFEST_PATH=
# COMPOSE_FILE: workspace-root-relative path to the base Compose file used by
# ComposeRunner subprocess invocations (always argv-list, shell=False).
# Default at runtime: ``infra/docker-compose.yml``. Left blank in the
# example to satisfy the placeholder-only invariant; the application
# applies the documented default when the variable is unset.
COMPOSE_FILE=

# =============================================================================
# PromptsGitRouter Configuration (platform-mimari-ops task 6.1 — Requirement 2.2)
# =============================================================================
# The keys below back the /admin/prompts CRUD/draft/PR endpoints exposed by
# `src/routers/prompts_git.py`. The router opens a local git clone and uses
# GitPython to list / read / write prompt Markdown files; every mutation
# goes through a `draft/<actor>-<ts>` branch and is opened as a PR against
# `PROMPTS_MAIN_BRANCH`. Plain-text credentials are NEVER read or written
# by this router — Bitbucket auth lives in the underlying mcp_client tool.
# =============================================================================

# PROMPTS_REPO_PATH: absolute path to the local clone of the prompts repo.
# Defaults at runtime to WORKSPACE_ROOT (i.e. the workspace folder that
# already holds `config/`, `services/` and `platform/prompts/`). Override
# when admin-dashboard-api runs as a sidecar with a dedicated clone.
PROMPTS_REPO_PATH=
# PROMPTS_MAIN_BRANCH: name of the branch every draft is forked from.
# Default at runtime: `main`. Override on legacy clones using `master`.
PROMPTS_MAIN_BRANCH=main
# PROMPTS_DIR_PREFIX: repository-relative prefix listed by GET /admin/prompts.
# Default at runtime: `platform/prompts/`. Empty string lists every .md file.
PROMPTS_DIR_PREFIX=platform/prompts/
