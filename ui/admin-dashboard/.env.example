# =============================================================================
# admin-dashboard .env.example (Standalone Mode)
# =============================================================================
# Copy this file to `.env` and run:
#   docker run --env-file .env -p 3000:3000 admin-dashboard
#
# All values below are PLACEHOLDERS / DEV-ONLY credentials
# (Requirements 10.6, 11.5). Do NOT use these values in production.
# =============================================================================

# --- Service ---
PORT=3000
LOG_LEVEL=INFO

# --- admin-dashboard-api (Next.js public env, exposed to the browser) ---
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://admin-dashboard-api:8082
NEXT_PUBLIC_STREAMLIT_URL=http://localhost:18501
# =============================================================================
# Control_Plane Configuration (admin-dashboard-control-plane spec — design §3.14)
# =============================================================================
# Keys above (PORT, LOG_LEVEL, NEXT_PUBLIC_ADMIN_API_BASE_URL) MUST NOT be
# removed or modified (Requirement 13.3). New entries are append-only.
# =============================================================================

# --- Servis Kataloğu polling (Requirement 12.4 — design §3.14) ---
# NEXT_PUBLIC_HEALTH_POLL_INTERVAL_SECONDS: client-side polling cadence the
# Servis Kataloğu sayfası uses to refresh per-service state. Mirrors the
# backend HEALTH_POLL_INTERVAL_SECONDS. Allowed range [5, 30]; default 10.
NEXT_PUBLIC_HEALTH_POLL_INTERVAL_SECONDS=10

# --- Stop Advanced toggle production guard (platform-mimari-uyumluluk
#     task 15.3 / R14 / Q16) ---
# NEXT_PUBLIC_DEPLOYMENT_PROFILE: mirrors the admin-dashboard-api
# DEPLOYMENT_PROFILE setting (``dev`` / ``staging`` / ``production``).
# Used by StopConfirmationModal to disable the "Vault override'larını
# sil" checkbox on production so the lifecycle endpoint's 403 guard
# (``purge_vault_forbidden_in_production``) is never triggered on the
# happy path. Defaults to ``dev`` when unset.
NEXT_PUBLIC_DEPLOYMENT_PROFILE=dev
