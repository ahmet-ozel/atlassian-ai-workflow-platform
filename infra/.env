# =============================================================================
# infra/.env — Compose default env (bu klasörden çalıştırınca otomatik okunur)
# =============================================================================
# Bu klasörün içinden:
#     docker compose -f docker-compose.yml up -d
# komutunu çalıştırınca Compose bu .env'i OTOMATİK okur (proje dizini = infra/).
# Sadece bootstrap bundle açılır: postgres, vault, admin-dashboard-api,
# admin-dashboard-ui. Geri kalan servisler dashboard'dan başlatılır.
#
# Üretimde DEĞİŞTİR: POSTGRES_PASSWORD, VAULT_TOKEN, OPENAI_API_KEY.
# Bu dosyayı git'e COMMIT ETME (.gitignore zaten .env'i hariç tutar).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai_dev_only
POSTGRES_DB=ai
POSTGRES_DSN=postgresql://ai:ai_dev_only@postgres:5432/ai
POSTGRES_HOST_PORT=5433


# -----------------------------------------------------------------------------
# 2. Vault
# -----------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-token-not-for-prod
VAULT_BACKEND=hashicorp


# -----------------------------------------------------------------------------
# 2b. admin-dashboard-api
# -----------------------------------------------------------------------------
PLATFORM_ENV=development
AUTH_MODE=dev
AUTH_PROVIDER=local
WORKSPACE_ROOT=/app
TEMPORAL_HOST=temporal:7233
MCP_METRICS_URL=http://atlassian-mcp:8090


# -----------------------------------------------------------------------------
# 2c. admin-dashboard-ui
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8082
NEXT_PUBLIC_STREAMLIT_URL=http://localhost:18501


# -----------------------------------------------------------------------------
# 3. Temporal
# -----------------------------------------------------------------------------
TEMPORAL_TASK_QUEUE=agent-runner


# -----------------------------------------------------------------------------
# 4. MCP / Firecrawl
# -----------------------------------------------------------------------------
MCP_BASE_URL=http://atlassian-mcp:8090
FIRECRAWL_BASE_URL=http://firecrawl:3002

# Runtime toggle for the web_search capability. The capability is derived
# only when BOTH this is "true" AND the department has web_search_enabled.
# Keep in sync with the firecrawl service being up.
FIRECRAWL_ENABLED=true

# Firecrawl egress allowlist (comma-separated host suffixes). The firecrawl
# service refuses to fetch any URL whose host is not listed here, returning
# HTTP 403 + ``egress_denied``. Empty = closed by default (deny all). The
# search engine host (duckduckgo.com) plus the documentation domains the bot
# is allowed to research live here; widen as needed per deployment.
FIRECRAWL_EGRESS_ALLOWLIST=duckduckgo.com,wikipedia.org,python.org,docs.python.org,realpython.com,geeksforgeeks.org,pythongeeks.org,wscubetech.com,w3schools.com,stackoverflow.com,github.com,medium.com,mikkegoes.com,uzaktanegitim.com,teknolojiweb.com,ultahost.com,hascoding.com,robotdreams.com.tr,teknohocam.com

# SSRF guard allowlist for the Atlassian MCP gateway. The gateway blocks any
# Atlassian URL that resolves to a private (non-global) IP. Self-hosted Jira/
# Confluence/Bitbucket on an internal network resolve to private IPs and are
# blocked until their domain is listed here (comma-separated, suffix match:
# e.g. "example.org" covers jira./wiki./bitbucket.example.org). Leave EMPTY for
# Atlassian Cloud (public hosts pass the DNS check). Do not put http:// or a
# port here, only the domain.
MCP_ALLOWED_URL_DOMAINS=


# -----------------------------------------------------------------------------
# 5. LLM  (BURAYA KENDI OPENAI KEY'INI GIR)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-5.5
# Optional tuning knobs for reasoning-capable models (o-series / gpt-5
# family / Claude 4). Leave blank to use the upstream defaults.
#   LLM_REASONING_EFFORT: minimal | low | medium | high
#   LLM_VERBOSITY:        low | medium | high  (gpt-5 family only)
LLM_REASONING_EFFORT=medium
LLM_VERBOSITY=
VLLM_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# 6. MinIO
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret_dev_only


# -----------------------------------------------------------------------------
# 10. SSH runners
# -----------------------------------------------------------------------------
SSH_HOST=
RUNNER_BASE_PATH=/var/ai-runner
RUNNER_DISK_WARN_PCT=80
RUNNER_DISK_EVICT_PCT=90


# -----------------------------------------------------------------------------
# 11. Feature flags
# -----------------------------------------------------------------------------
FEATURE_FLAG_AI_ENABLED=true
FEATURE_FLAG_EXECUTION_ENABLED=true
FEATURE_FLAG_TASK_INTAKE_ENABLED=false
FEATURE_FLAG_FIRECRAWL_ENABLED=false
FEATURE_FLAG_PR_AUTO_MERGE_ENABLED=false
FEATURE_FLAG_AUDIT_PRUNE_ENABLED=false
SSH_RUNNER_DEPT_PINNING_ENABLED=false
SSH_DEPT_QUOTA_ENABLED=false


# -----------------------------------------------------------------------------
# 12. Observability / Log
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
