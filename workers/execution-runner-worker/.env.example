# =============================================================================
# execution-runner-worker .env.example
# =============================================================================
# Copy to ``.env`` and adjust as needed. All values are PLACEHOLDERS /
# DEV-ONLY credentials (Requirements 8.8, 11.5). Do NOT use in
# production. The workspace ``.gitignore`` excludes ``.env`` files.
#
# This file is the per-worker slice of the master env reference table
# (``platform/docs/env-reference.md``, task 10.4) and stays in parity
# with it (Requirement 8.4 — verified by
# ``tests/property/test_env_coverage.py``). Sensitive keys whose
# ``vault_path`` column is populated in env-reference.md are left
# **empty** or carry the ``_dev_only`` suffix (Requirement 8.5, 8.8).
# =============================================================================

# -----------------------------------------------------------------------------
# Observability (env-reference §12)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
CLIENT_SOURCE=execution-runner-worker

# -----------------------------------------------------------------------------
# Temporal (env-reference §3)
# -----------------------------------------------------------------------------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=execution-runner-tq

# -----------------------------------------------------------------------------
# Vault (env-reference §2 — SSH key dual-slot rotation source of truth)
# -----------------------------------------------------------------------------
VAULT_BACKEND=hashicorp
VAULT_ADDR=http://vault:8200
# vault_path: vault:infrastructure/vault/root_token
VAULT_TOKEN=dev-token-not-for-prod

# -----------------------------------------------------------------------------
# Postgres (env-reference §1 — audit + workflow state)
# -----------------------------------------------------------------------------
# vault_path: vault:infrastructure/postgres/dsn
POSTGRES_DSN=postgresql://ai:ai_dev_only@postgres:5432/ai

# -----------------------------------------------------------------------------
# MinIO (env-reference §6 — artifact upload/download)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
# vault_path: vault:minio/access_keys
MINIO_ROOT_PASSWORD=miniosecret_dev_only

# -----------------------------------------------------------------------------
# SSH runners (env-reference §10 — execution capability source)
# -----------------------------------------------------------------------------
# DEPRECATED — SSH_HOST is deprecated. See infrastructure.ssh_runners table
# (managed via admin panel at /admin/security/ssh-runners) for the new
# multi-runner model. When SSH_HOST is set at boot, the worker auto-seeds a
# 'default' runner row for backward compatibility (R4.3, R4.17).
# New deployments MUST NOT rely on SSH_HOST; configure runners via the
# admin panel instead.
#
# When SSH_HOST is not set AND infrastructure.ssh_runners is empty, the
# worker boots normally but logs a 'runner_pool_empty' warning (R4.19).
SSH_HOST=
# Deprecated legacy aliases (DO NOT use in new deployments). Resolution
# order: SSH_HOST > SSH_HOST_1 > "localhost". SSH_HOST_2 / SSH_HOST_3 are
# ignored at runtime and will be removed in a future release.
SSH_HOST_1=
SSH_HOST_2=
SSH_HOST_3=
SSH_USER_DEFAULT=runner
SSH_PORT_DEFAULT=22
SSH_KEY_VAULT_PREFIX=vault:ssh/runners
SSH_CONNECT_TIMEOUT_S=15
SSH_COMMAND_TIMEOUT_S=1800
SSH_KNOWN_HOSTS_PATH=/etc/ssh/ssh_known_hosts

# -----------------------------------------------------------------------------
# Runner workspace root (env-reference §10 — uyumluluk Requirement 11.1, Q13)
# -----------------------------------------------------------------------------
# Workspace kök klasörü. Task workspace'leri
# {RUNNER_BASE_PATH}/{ISSUE_KEY}/iter-{N}/ formatında oluşturulur
# (``runners/workspace_path.py::build_workspace_path``).
#
# Single-runner canonical contract: bu path **tek SSH runner**'da, **tüm
# departmanlar tarafından paylaşılır**. Per-department alt klasörlere
# bölünmez — task workspace'leri doğrudan ``{ISSUE_KEY}/iter-{N}/`` olarak
# yerleşir; loop guard issue_key prefix'i üzerinden çalışır.
RUNNER_BASE_PATH=/var/ai-runner
# SSH_BASE_PATH (deprecated alias for RUNNER_BASE_PATH) — eski deployment'lar
# için ``pydantic-settings`` ``AliasChoices`` üzerinden fallback olarak okunur;
# yeni kurulumlarda yalnızca ``RUNNER_BASE_PATH`` set edilmelidir.
# SSH_BASE_PATH=/var/ai-runner

# -----------------------------------------------------------------------------
# Workspace disk auto-prune (G2: WorkspaceCleanupSchedulerWorkflow)
# -----------------------------------------------------------------------------
# Single-runner contract gereği tek SSH host = tek darboğaz. ``cleanup_policy=
# never`` task'ları veya hata fırlatıp ``on_success``'in atlandığı durumlar
# disk'i doldurur. ``WorkspaceCleanupSchedulerWorkflow`` (Temporal cron, hourly)
# bu eşikleri kullanarak en eski ``iter-N`` klasörlerini siler.
#
# - WARN_PCT'ye ulaşıldığında admin-dashboard'a sarı banner gönderilir.
# - EVICT_PCT'ye ulaşıldığında en eski iter-N klasörleri (mtime'a göre)
#   kullanım bu eşiğin altına düşene kadar tek tek silinir; kaldırılan her
#   klasör ``workspace_auto_pruned`` audit event'i ile kaydedilir.
RUNNER_DISK_WARN_PCT=80
RUNNER_DISK_EVICT_PCT=90

# -----------------------------------------------------------------------------
# Feature flags (env-reference §11; Requirements 4.8, 4.9 — default-off)
# -----------------------------------------------------------------------------
FEATURE_FLAG_EXECUTION_ENABLED=true
# DEPRECATED — bu iki flag tek-runner kanonik kontrat altında no-op'tur (G1).
# Per-dept SSH pinning ve per-dept disk quota kaldırıldı; tüm departmanlar tek
# host'u paylaşır ve disk yönetimi global ``RUNNER_DISK_WARN_PCT`` /
# ``RUNNER_DISK_EVICT_PCT`` eşikleri üzerinden ``WorkspaceCleanupSchedulerWorkflow``
# tarafından yapılır. Default ``false`` korunur; gelecekteki bir release'de
# kaldırılacak.
SSH_RUNNER_DEPT_PINNING_ENABLED=false
SSH_DEPT_QUOTA_ENABLED=false
